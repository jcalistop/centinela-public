{
  "openapi": "3.0.3",
  "info": {
    "title": "Centinela Agent API v1",
    "version": "1.0.0",
    "description": "Fachada de lectura P3a. Solo GET. Contrato neutral: instrumento como atributo."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health extendido",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/years": {
      "get": {
        "summary": "Catálogo de años",
        "operationId": "getYears",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/context": {
      "get": {
        "summary": "Contexto año/SS del request",
        "operationId": "getContext",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/instrumentos": {
      "get": {
        "summary": "Instrumentos disponibles",
        "operationId": "getInstrumentos",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/compromisos": {
      "get": {
        "summary": "Compromisos COMGES (paginado)",
        "operationId": "getCompromisos",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/indicadores": {
      "get": {
        "summary": "Listado indicadores neutrales",
        "operationId": "getIndicadores",
        "parameters": [
          {
            "name": "instrumento",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "comges",
                "metas"
              ]
            }
          },
          {
            "name": "ley",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/indicadores/{id}": {
      "get": {
        "summary": "Detalle indicador",
        "operationId": "getIndicador",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "instrumento",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "comges",
                "metas"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "No encontrado"
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Búsqueda unificada de indicadores COMGES+Metas (sin exigir instrumento)",
        "operationId": "searchIndicadores",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "422": {
            "description": "q inválido"
          }
        }
      }
    },
    "/establecimientos": {
      "get": {
        "summary": "Establecimientos del SS del token (catálogo + dirección; paginado)",
        "operationId": "listEstablecimientos",
        "parameters": [
          {
            "name": "tipo",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Alias SAR|SAPU|SUR o glosa exacta de tipo"
          },
          {
            "name": "vigente",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "true = estados Vigente en Operación Habitual/Transitoria"
          },
          {
            "name": "estado_funcionamiento",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "comuna",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — data + meta.total"
          },
          "422": {
            "description": "tipo inválido"
          }
        }
      }
    },
    "/establecimientos/{id}": {
      "get": {
        "summary": "Ficha de establecimiento (mismo SS del token)",
        "operationId": "getEstablecimiento",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "No encontrado / otro SS"
          }
        }
      }
    },
    "/resultados": {
      "get": {
        "summary": "Resultados Metas por establecimiento (paginado, filtrado por SS del token)",
        "operationId": "getResultados",
        "parameters": [
          {
            "name": "instrumento",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "metas"
              ]
            }
          },
          {
            "name": "indicador_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/mcp/list-formulacion": {
      "get": {
        "summary": "MCP list-formulacion-tool — formulación Metas por establecimiento×indicador (solo lectura; sin paridad REST)",
        "operationId": "mcpListFormulacion",
        "description": "Contrato de agentes. Filtros: ley (obligatoria 18834|19664|20707), year, establecimiento_id, estado (BORRADOR|ENVIADO), aplica, per_page (máx. 100), page. empty_reason: ausente|sin_datos|fuera_de_alcance. estado_convenio nunca VALIDADO; justificacion siempre null.",
        "parameters": [
          {
            "name": "ley",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "18834",
                "19664",
                "20707"
              ]
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "establecimiento_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "BORRADOR",
                "ENVIADO"
              ]
            }
          },
          {
            "name": "aplica",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope AgentPagination (data + meta)"
          }
        }
      }
    },
    "/mcp/list-documentos": {
      "get": {
        "summary": "MCP list-documentos-tool — documentos normativos del SS (solo lectura; sin paridad REST)",
        "operationId": "mcpListDocumentos",
        "description": "Contrato de agentes. Filtros: year (default YearContext), ley (18834|19664|20707), instrumento (comges|metas|adp), per_page (máx. 100), page. empty_reason: ausente|sin_datos. hash siempre null; sin filtro establecimiento.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ley",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "18834",
                "19664",
                "20707"
              ]
            }
          },
          {
            "name": "instrumento",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "comges",
                "metas",
                "adp"
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope AgentPagination (data + meta)"
          }
        }
      }
    },
    "/mcp/get-documento": {
      "get": {
        "summary": "MCP get-documento-tool — metadatos + URL firmada temporal",
        "operationId": "mcpGetDocumento",
        "description": "Devuelve el contrato de documento más download_url y expires_at (TTL centinela.agent_document_url_ttl_minutes). id inexistente o de otro SS → NOT_FOUND.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Documento + download_url + expires_at"
          }
        }
      }
    },
    "/dashboard/alertas": {
      "get": {
        "summary": "Alertas dashboard parametrizadas",
        "operationId": "getDashboardAlertas",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/glossary": {
      "get": {
        "summary": "Glosario versionado",
        "operationId": "getGlossary",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Contrato OpenAPI",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
