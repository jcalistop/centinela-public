APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Versión mostrada en UI / logs (alinear con tag SemVer en producción, p. ej. v4.1.1).
APP_VERSION=

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# --- Instalación limpia de la app (BD del .env / DB_DATABASE) ---
# 1) Crear BD vacía = DB_DATABASE
# 2) CENTINELA_ALLOW_DESTRUCTIVE_DATABASE_COMMANDS=true  (solo local; wipe consciente)
# 3) composer run schema:fresh
#    o: php artisan centinela:schema-fresh --seed
# 4) si no usaste --seed: php artisan db:seed
# Luego volver CENTINELA_ALLOW_DESTRUCTIVE_DATABASE_COMMANDS=false

# Bypass para wipe MySQL (schema:fresh, migrate:fresh, db:wipe, …). Guard multi-capa.
# No habilitar en agentes automatizados sin decisión explícita. Smoke PHP: composer run test:migrate:fresh.
CENTINELA_ALLOW_DESTRUCTIVE_DATABASE_COMMANDS=false

# --- TOOL dump/paridad (NO instalar la app aquí) ---
# Solo al regenerar/auditar database/schema/mysql-schema.sql. BD distinta de DB_DATABASE.
# Tras schema:parity → ELIMINAR la BD (DROP DATABASE) y comentar estas vars (evita confusiones).
# DB_SCHEMA_PARITY_DATABASE=centinela_schema_parity
# DB_SCHEMA_PARITY_HOST=127.0.0.1
# DB_SCHEMA_PARITY_PORT=3306
# DB_SCHEMA_PARITY_USERNAME=root
# DB_SCHEMA_PARITY_PASSWORD=

# Temporales (storage/temp + storage/app/temp; paths no unificados) y logs del scheduler
CENTINELA_STORAGE_TEMP_MAX_AGE_HOURS=48
CENTINELA_SCHEDULE_LOGS_RETENTION_DAYS=14
CENTINELA_SCHEDULE_LOGS_ROTATE_MAX_BYTES=5242880

# Retención ops (fuente de verdad: config/centinela.php). Alias legacy en services.php.
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_AGE_HOURS=24
AUDIT_RETENTION_MONTHS=6
SECURITY_LOG_RETENTION_DAYS=30
WORKER_FAILED_JOBS_RETENTION_HOURS=168
CENTINELA_SUPPORT_CLOSE_RESOLVED_DAYS=5
WORKER_STALE_MINUTES=30
WORKER_PENDING_WARNING_JOBS=5
WORKER_FAILED_JOBS_WARNING_24H=5
SCHEDULER_HEARTBEAT_THRESHOLD_MINUTES=150

# Techo de subida de archivos en la aplicación (kilobytes; 51200 = 50 MB; paneles CSV).
CENTINELA_UPLOAD_MAX_KB=51200

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Cambiar a database para habilitar el envío asincrónico de correos
QUEUE_CONNECTION=database
# Tiempo máximo de espera para reintentar trabajos fallidos (en segundos)
QUEUE_RETRY_AFTER=90
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie de sesión solo por HTTPS. Intranet (prod): true. Local HTTP (*.test / localhost): false u omitir.
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Dirección de correo para notificaciones del sistema (ej. recuperación de contraseña)
MAIL_FROM_ADDRESS="centinela@minsal.cl"
MAIL_FROM_NAME="Sistema Centinela"

# Opcional: credenciales dedicadas para respaldos (si difieren de la conexión principal)
# Usuario con permisos mínimos (SELECT, LOCK TABLES, SHOW VIEW, TRIGGER) y privilegios de dump
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=

# Ruta del directorio donde está el binario mysqldump (solo si no está en PATH)
# Ejemplo Windows: DB_DUMP_PATH='C:\mysql-8.0.25-winx64\bin'
# Ejemplo Linux: DB_DUMP_PATH='/usr/local/mysql/bin'
DB_DUMP_PATH=

# Token secreto para ejecución de tareas mediante API/Cron externo
# Genera un token seguro con: php artisan key:generate --show | base64
CRON_SECRET_TOKEN=

# Configuración de auditoría
# Habilitar/deshabilitar el sistema de auditoría
AUDITING_ENABLED=true

# Configuración de WhatsApp (Meta Cloud API)
# Token de acceso a la API de WhatsApp Business (obtener desde Meta Developer Console)
WHATSAPP_CLOUD_API_TOKEN=
# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de WhatsApp Business
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Número de teléfono de destino para alertas (formato: +56912345678)
WHATSAPP_ALERT_TO=

# Deploy interno / repo releases se gestionan en /admin/settings (servicios y sistema).
# Solo dejar variables sensibles aquí.
# PAT único GitHub para esta app: API de releases (rate limit; opcional si el repo es público) + promoción Soporte→issue.
# Scopes típicos: PAT classic `repo`, o fine‑grained con contenido/releases/issues según repos. Migración: valor de RELEASES_TOKEN → aquí.
CENTINELA_GITHUB_TOKEN=

# TTL opcional (minutos) del token emitido por POST /api/admin/token. Vacío = sin caducidad extra (solo config/sanctum).
CENTINELA_ADMIN_API_TOKEN_TTL_MINUTES=

# Orígenes CORS permitidos para `api/*` y `sanctum/csrf-cookie`, separados por coma (ej. https://app.example.com).
# Vacío: en production → lista vacía (sin `*`); en local/testing → `*`.
CORS_ALLOWED_ORIGINS=

# P3a — superficie agentes api/v1 y mcp. Default off; no activar en prod sin egreso PII.
# Filament maestro hard-off; keys viven en config/centinela.php.
# Olas de envío masivo (cola database).
CENTINELA_MESSAGING_WAVE_SIZE=25
CENTINELA_MESSAGING_WAVE_DELAY_SECONDS=300

# TTL (días) de URL firmada de preview de paneles públicos no publicados.
CENTINELA_PUBLIC_INFO_PANEL_PREVIEW_TTL_DAYS=7

CENTINELA_AGENT_API_ENABLED=false
# IPs/CIDR separadas por coma; vacío = sin allowlist.
CENTINELA_AGENT_IP_ALLOWLIST=
CENTINELA_AGENT_TOKEN_TTL_MINUTES=10080
CENTINELA_AGENT_THROTTLE_PER_MINUTE=120
CENTINELA_AGENT_REQUEST_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# MONITOREO EXTERNO (PC independiente) -- scripts/monitor/
# ---------------------------------------------------------------------------
# El monitor se configura localmente en scripts/monitor/config/monitor.config.json
# y secrets/monitor.secrets.json. No requiere variables de .env adicionales.
#
# Flujo: run_monitor_silent.vbs -> CentinelMonitoR.ps1 -> GET /api/health
#   -> decide alertas inmediatas, acciones correctivas y reportes diarios/semanales
#
# Las variables CRON_SECRET_TOKEN, SCHEDULER_*, WORKER_*, BACKUP_*, SECURITY_*
# de este .env alimentan los endpoints que el monitor consume.
# ---------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
